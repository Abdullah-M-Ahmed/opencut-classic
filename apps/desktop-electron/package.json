{
  "name": "@opencut/desktop-electron",
  "private": true,
  "version": "0.1.1",
  "description": "Windows desktop launcher for the OpenCut Classic editor",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "package:windows": "node scripts/prepare-runtime.mjs && electron-builder --win nsis --x64 --publish never",
    "check": "node --check main.cjs && node --check scripts/prepare-runtime.mjs && node --check scripts/smoke-test-runtime.mjs && node --check scripts/smoke-test-desktop.mjs"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.opencut.community.desktop",
    "productName": "OpenCut Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/runtime/**"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "opencut-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "OpenCut-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
